{
  "name": "telly-bot",
  "description": "A Telegram bot based on Bun.",
  "version": "0.1.0",
  "author": "LolipopJ",
  "license": "MIT",
  "module": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "server": "bun run src/index.ts",
    "eslint": "eslint src/**/*.ts",
    "prettier": "prettier . --write --ignore-unknown",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "@types/bun": "^1.1.2",
    "@types/eslint__js": "^8.42.3",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "prettier": "^3.2.5",
    "typescript-eslint": "^7.10.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
